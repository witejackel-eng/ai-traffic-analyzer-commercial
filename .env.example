# AI Traffic Analyzer — environment configuration
# Copy this file to `.env` and adjust values. NEVER commit your real .env.

# ---- AI Vision Provider ----
# mock | generic-http | local-inference
AI_PROVIDER=mock

# Used only by generic-http / local-inference providers. Leave blank for demo.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Local inference endpoint (used by local-inference provider)
LOCAL_INFERENCE_URL=http://localhost:8001

# ---- Storage ----
VIDEO_STORAGE_PATH=./storage/videos
OUTPUT_STORAGE_PATH=./storage/outputs

# ---- Upload limits ----
MAX_UPLOAD_MB=1024

# ---- Analysis defaults ----
DEFAULT_FRAME_RATE=2

# ---- Database ----
#
# FOR LOCAL DEVELOPMENT (SQLite — zero-config, file-based):
DATABASE_URL=file:./db/custom.db
#
# FOR VERCEL / SERVERLESS DEPLOYMENT:
# SQLite (file:) does NOT work on Vercel — the filesystem is read-only and
# ephemeral. You MUST use a real Postgres database.
#
# Option A — Vercel Postgres (free, one-click from Vercel dashboard):
#   1. Go to your project → Storage → Create → Postgres
#   2. Copy the DATABASE_URL from the ".env.local" tab
#   3. Set it as a Vercel environment variable named DATABASE_URL
#
# Option B — Neon (serverless Postgres, free tier):
#   DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
#
# Option C — Supabase (free tier):
#   DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
#
# After setting DATABASE_URL, the build runs `prisma db push` automatically
# (see the `vercel-build` script in package.json) — no manual migration needed.
#
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Application ----
NODE_ENV=development
PORT=3000

# ---- Real Vision Pipeline (required for real AI analysis) ----
# Path to the Python interpreter with cv2 + onnxruntime installed.
# On Linux: /usr/bin/python3 or your venv path (e.g. /home/user/.venv/bin/python3)
# On macOS: python3 (if installed via brew)
# If left blank, the system default `python3` is used.
PYTHON_BIN=python3

# Vision worker URL (used by the local-inference HTTP adapter; not needed
# for the subprocess-based real analysis pipeline).
VISION_WORKER_URL=http://localhost:8001

